


# platform MUST be set for App Store + modern iOS
install! 'cocoapods',
  :disable_input_output_paths => true
platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# ✅ FIX 1: Remove duplicate aosl.xcframework from AgoraRtm.
# Both agora_rtc_engine (>=4.5.0) and agora_rtm (>=2.2.0) bundle it.
# AgoraRtcEngine already provides the authoritative copy.
pre_install do |installer|
  rtm_pod_path = File.join(installer.sandbox.root, 'AgoraRtm')
  aosl_path = File.join(rtm_pod_path, 'aosl.xcframework')
  if File.exist?(aosl_path)
    puts "✅ Removing duplicate aosl.xcframework from AgoraRtm..."
    FileUtils.rm_rf(aosl_path)
  else
    puts "ℹ️  aosl.xcframework not found in AgoraRtm (already clean)."
  end
end

target 'Runner' do
  # ✅ Modular headers for SDWebImage (DKPhotoGallery needs ObjC import)
  pod 'SDWebImage', :modular_headers => true
  pod 'SDWebImageWebPCoder', :modular_headers => true

  # ✅ Modular headers required by Firebase 12.x Swift pods
  # (FirebaseAuth, FirebaseCoreInternal, AppCheckCore all depend on these
  # ObjC pods and need module maps to be imported from Swift in static builds)
  # ✅ Modular headers required by Firebase 12.x Swift pods
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'AppAuth', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Pods that have a broken swiftinterface due to the Swift compiler bug
  # where a public type shares the same name as its module.
  # BUILD_LIBRARY_FOR_DISTRIBUTION must be NO for these or the verifier
  # will reject their pre-compiled .swiftinterface files at build time.
  broken_interface_pods = %w[
    DKPhotoGallery
    DKImagePickerController
    DKPhotoGallery
    SwiftyGif
    AppCheckCore
    GTMAppAuth
    FirebaseMessaging
  ]

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['VALIDATE_WORKSPACE'] = 'NO'
      config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
      ]

      # 🔴 NEW FIX: For Release builds, disable aggressive optimizations that break Agora
      if config.name == 'Release'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'  # ✅ Disable optimizations
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'         # ✅ Disable C optimization
        config.build_settings['STRIP_INSTALLED_PRODUCTS'] = 'NO'      # ✅ Don't strip binaries
        config.build_settings['COPY_PHASE_STRIP'] = 'NO'              # ✅ Don't strip on copy
        config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'           # ✅ Keep all symbols
        puts "🔴 Applied iOS Release optimizations fix for Agora"
      end

      if broken_interface_pods.include?(target.name)
        # ✅ FIX 3: Disable library-for-distribution + interface verification
        # for pods whose .swiftinterface has the module-name == type-name bug.
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        config.build_settings['SWIFT_EMIT_MODULE_INTERFACE'] = 'NO'
        puts "⚠️  Disabled BUILD_LIBRARY_FOR_DISTRIBUTION for #{target.name} (broken swiftinterface)"
      else
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      end
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each do |config_name, config_file|
      config_file.attributes['OTHER_LDFLAGS'] ||= '$(inherited)'
      # 🔴 NEW: Ensure Agora symbols are visible
      config_file.attributes['OTHER_LDFLAGS'] += ' -undefined dynamic_lookup'
    end
  end
end
